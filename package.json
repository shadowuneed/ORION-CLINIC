{
  "name": "orion-clinic",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-user-handbook.mjs && vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply orion-clinic-local --local --persist-to .wrangler/state",
    "db:bootstrap:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/bootstrap.local.sql",
    "db:seed:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/seed.local.sql",
    "db:seed:scheduling:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/seed.scheduling.local.sql",
    "db:seed:care:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/seed.chronic-care.local.sql",
    "db:seed:communications:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/seed.communications.local.sql",
    "db:seed:observations:local": "wrangler d1 execute orion-clinic-local --local --persist-to .wrangler/state --file db/seed.observations.local.sql",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:dependencies": "pnpm audit --audit-level high",
    "backup:drill:local": "node scripts/local-backup-restore-drill.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build",
    "verify:ci": "pnpm security:secrets && pnpm security:dependencies && pnpm verify && pnpm backup:drill:local"
  },
  "dependencies": {
    "@expo-google-fonts/golos-text": "0.4.2",
    "@fontsource-variable/golos-text": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.134.0"
  },
  "type": "module"
}
