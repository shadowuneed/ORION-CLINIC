backups/
exports/
recordings/
tmp/
test-results/
playwright-report/
coverage/
*.log
*.tsbuildinfo
**/*.db
**/*.db-*
**/*.sqlite*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.wav
**/*.webm
**/*.mp3
