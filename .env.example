ORION_ENV=development
ORION_BUILD_ID=local
ORION_SYNTHETIC_DATA_ONLY=true
ORION_STT_BASE_URL=http://127.0.0.1:3101
ORION_STT_MODEL=gigaam-multilingual-local
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY must be injected as a local/deployment secret and never committed.
# Optional compatibility override for manual web-source checks. If it is absent,
# the `/api/clinical/research` route reuses the injected GROQ_API_KEY.
# GROQ_COMPOUND_API_KEY must also be injected as a secret and never committed.
GROQ_COMPOUND_MODEL=groq/compound-mini
